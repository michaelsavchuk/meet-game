{
  "manifest_version": 3,
  "name": "Meet Chat Game Bridge",
  "version": "0.1.0",
  "description": "Forwards new Google Meet chat messages and emoji reactions to a game server.",
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["chat-observer.js"]
    },
    {
      "matches": ["https://meet.google.com/*"],
      "run_at": "document_idle",
      "js": ["chat-observer.js"]
    }
  ],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://localhost:8787/*"]
}
