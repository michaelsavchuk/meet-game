{
  "manifest_version": 3,
  "name": "Meet Game",
  "version": "0.2.0",
  "description": "A typing battle game for Google Meet calls. Share the game tab; everyone plays by chatting and reacting.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Meet Game" },
  "side_panel": { "default_path": "control.html" },
  "permissions": ["sidePanel"],
  "background": { "service_worker": "extension/background.js" },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["extension/chat-observer.js"]
    },
    {
      "matches": ["https://meet.google.com/*"],
      "run_at": "document_idle",
      "js": ["extension/chat-observer.js"]
    }
  ]
}
